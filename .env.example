# 复制为 .env 后在本地填写。不要把 .env 提交到仓库，不要把真实值发到聊天。
# 本文件只保留变量名和说明。

# 运行环境：development | test | production
NODE_ENV=development

# 本机访问地址，阶段 1 创建应用后使用
APP_URL=http://localhost:3000

# 服务端会话签名密钥。用本地随机长字符串填写，不要复用示例。
AUTH_SECRET=

# Sealos Cloud PostgreSQL 连接串。
# 从 Sealos 数据库详情页复制主机、端口、库名、用户名，在本地 .env 中填入。
# 是否加 sslmode 以控制台说明为准。不要把这条真实连接串写入源码或聊天。
# 格式：postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=

# 仅开发环境允许运行虚构种子账号。生产必须为 false 或不设置。
SEED_ENABLED=false

# 生产须持久化工作目录下 uploads/ 与 backups/（见 README「生产部署要点」）。

# AI：OpenAI 兼容 Chat Completions。只在服务端读取，不要把真实 Key 写入源码或聊天。
# DeepSeek 示例：AI_BASE_URL=https://api.deepseek.com  AI_MODEL=deepseek-chat
# 服务端会在地址末尾补上 /v1。没有 Key 时，教学记录仍可保存，报告生成应失败并可重试。
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# 单次调用超时（毫秒）
AI_TIMEOUT_MS=30000

# 机构默认时区。展示用，数据库时间仍保存为带时区的时刻。
DEFAULT_TIMEZONE=Asia/Shanghai

# 短信服务商标识。生产环境在接入真实短信前保持 unconfigured。
# 未接入时，生产环境必须拒绝发送，不能返回固定验证码或假装发送成功。
# 开发环境由服务端生成一次性验证码，只在开发接口响应中返回。短信密钥不要写入代码或提交到仓库。
SMS_PROVIDER=unconfigured
