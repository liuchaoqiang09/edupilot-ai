generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["edupilot"]
}

enum Role {
  OWNER
  TEACHER
  PARENT

  @@schema("edupilot")
}

enum MemberStatus {
  ACTIVE
  INACTIVE

  @@schema("edupilot")
}

enum CourseCategory {
  ACADEMIC
  ART
  EARLY_CHILDHOOD
  OTHER

  @@schema("edupilot")
}

enum ArchiveStatus {
  ACTIVE
  ARCHIVED

  @@schema("edupilot")
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED

  @@schema("edupilot")
}

enum AttendanceStatus {
  NOT_MARKED
  PRESENT
  ABSENT
  LATE
  LEAVE

  @@schema("edupilot")
}

enum ReportStatus {
  DRAFT
  CONFIRMED
  PUBLISHED
  RETURNED

  @@schema("edupilot")
}

enum EnrollmentStatus {
  PAID
  PARTIAL
  UNPAID

  @@schema("edupilot")
}

enum BillingType {
  PER_LESSON
  PER_PERIOD

  @@schema("edupilot")
}

/// 机构是租户边界。主键即租户标识，业务数据通过 organizationId 指向这里。
model Organization {
  id                     String           @id @default(cuid())
  name                   String
  timezone               String           @default("Asia/Shanghai")
  businessTypes          CourseCategory[] @default([ACADEMIC])
  reportLanguage         String           @default("zh-CN")
  aiUseRecentSummaries   Boolean          @default(true)
  aiRequireEvidence      Boolean          @default(true)
  aiTeacherMustConfirm   Boolean          @default(true)
  aiOwnerSpotCheck       Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  users              User[]
  students           Student[]
  teachers           Teacher[]
  courses            Course[]
  classGroups        ClassGroup[]
  parentStudentLinks ParentStudentLink[]
  lessonSessions     LessonSession[]
  lessonStudents     LessonStudent[]
  teachingRecords    TeachingRecord[]
  teachingReports    TeachingReport[]
  enrollments        Enrollment[]
  auditLogs          AuditLog[]
  courseHourBalances CourseHourBalance[]
  membershipInvites  MembershipInvite[]

  @@schema("edupilot")
}

/// 登录身份。邮箱仍可用于密码登录；手机号可空，同一个手机号只能对应一个账号。
model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String       @unique
  phone          String?      @unique
  passwordHash   String
  name           String
  roles          Role[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  teacherProfile     Teacher?             @relation("TeacherLogin")
  accountTeacher     Teacher?             @relation("TeacherAccount")
  parentStudentLinks ParentStudentLink[]
  createdLessons     LessonSession[]
  confirmedReports   TeachingReport[] @relation("ReportConfirmedBy")
  publishedReports   TeachingReport[] @relation("ReportPublishedBy")
  createdEnrollments Enrollment[]
  auditLogs          AuditLog[]
  membershipInvites  MembershipInvite[]

  @@index([organizationId])
  @@schema("edupilot")
}

/// 学生档案。停用只改变状态，不删除记录。
model Student {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  studentNo      String?
  grade          String?
  contactNote    String?
  status         MemberStatus       @default(ACTIVE)
  /// 停用时填写的原因。恢复在读后清空。
  archiveReason  String?
  /// 旧的学员总课时。新的扣课以 CourseHourBalance 为准，不再读写这个字段。
  remainingHours Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  parentLinks    ParentStudentLink[]
  lessonStudents LessonStudent[]
  teachingReports TeachingReport[]
  enrollments    Enrollment[]
  courseHourBalances CourseHourBalance[]
  membershipInvites MembershipInvite[]

  @@unique([organizationId, studentNo])
  @@index([organizationId])
  @@schema("edupilot")
}

/// 教师档案。可以先独立存在，之后再关联登录账号。
model Teacher {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?      @unique
  user           User?        @relation("TeacherLogin", fields: [userId], references: [id], onDelete: SetNull)
  /// 这位老师注册过的登录账号。取消关联时保留，方便以后重新关联，不包含密码。
  accountUserId  String?      @unique
  accountUser    User?        @relation("TeacherAccount", fields: [accountUserId], references: [id], onDelete: SetNull)
  name           String
  /// 11 位手机号。空表示未填写。
  phone          String?
  /// 微信号，只含字母、数字和下划线。
  wechat         String?
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  classGroups    ClassGroup[]
  lessonSessions LessonSession[]
  teachingRecords TeachingRecord[]
  membershipInvites MembershipInvite[]
  courses        TeacherCourse[]

  @@index([organizationId])
  @@schema("edupilot")
}

/// 课程类型。名称由机构自建，不等于某一节课。
model Course {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  category       CourseCategory?
  description    String?
  billingType    BillingType     @default(PER_LESSON)
  status         ArchiveStatus   @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  classGroups    ClassGroup[]
  teachers       TeacherCourse[]
  enrollments    Enrollment[]
  lessonSessions LessonSession[]
  courseHourBalances CourseHourBalance[]

  @@index([organizationId])
  @@schema("edupilot")
}

/// 教师可教授的课程。同一对教师和课程只保留一条。
model TeacherCourse {
  teacherId String
  courseId  String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([teacherId, courseId])
  @@index([courseId])
  @@schema("edupilot")
}

/// 班级或教学组。主讲教师可在以后的课次里单独调整。
model ClassGroup {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id])
  teacherId      String
  teacher        Teacher       @relation(fields: [teacherId], references: [id])
  capacity       Int?
  status         ArchiveStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lessonSessions LessonSession[]
  enrollments    Enrollment[]

  @@index([organizationId])
  @@index([courseId])
  @@index([teacherId])
  @@schema("edupilot")
}

/// 某一天实际发生的一节课。课程和教师在创建时单独保存，之后改班级不会改写历史课次。
model LessonSession {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  classGroupId   String
  classGroup     ClassGroup    @relation(fields: [classGroupId], references: [id])
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id])
  teacherId      String
  teacher        Teacher       @relation(fields: [teacherId], references: [id])
  title          String?
  startAt        DateTime
  endAt          DateTime
  location       String?
  status         LessonStatus  @default(SCHEDULED)
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  students       LessonStudent[]
  teachingRecord TeachingRecord?
  reports        TeachingReport[]

  @@index([organizationId, startAt])
  @@index([teacherId, startAt])
  @@index([classGroupId])
  @@schema("edupilot")
}

/// 一节课的实际学生名单和考勤。同一课次里同一学生只能出现一次。
model LessonStudent {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id])
  lessonSessionId  String
  lessonSession    LessonSession    @relation(fields: [lessonSessionId], references: [id])
  studentId        String
  student          Student          @relation(fields: [studentId], references: [id])
  attendanceStatus AttendanceStatus @default(NOT_MARKED)
  attendanceNote   String?
  hoursCharged     Boolean          @default(false)
  lastAction       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([lessonSessionId, studentId])
  @@index([organizationId])
  @@index([studentId])
  @@schema("edupilot")
}

/// 某一学员在某一课程上的可用课时。同一学员的不同课程分开记账。
model CourseHourBalance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id])
  remainingHours Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, courseId])
  @@index([organizationId])
  @@schema("edupilot")
}

/// 一次报名或缴费。购买课时加到对应课程的可用课时，不并入其他课程。
model Enrollment {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id])
  courseId       String
  course         Course           @relation(fields: [courseId], references: [id])
  /// 报名所在班级。旧数据可先留空，排课按这个字段取本班学生。
  classGroupId   String?
  classGroup     ClassGroup?      @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  amountDue      Decimal          @db.Decimal(10, 2)
  amount         Decimal          @db.Decimal(10, 2)
  hoursAdded     Int
  status         EnrollmentStatus
  /// 按周期报名的有效期。按课时报名时留空。
  startDate      DateTime?        @db.Date
  endDate        DateTime?        @db.Date
  paidAt         DateTime?
  createdById    String
  createdBy      User             @relation(fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId, createdAt])
  @@index([studentId])
  @@index([courseId])
  @@index([classGroupId])
  @@schema("edupilot")
}

/// 家长与学生的绑定。同一对关系只能存在一次。
model ParentStudentLink {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  parentUserId   String
  parent         User         @relation(fields: [parentUserId], references: [id])
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([parentUserId, studentId])
  @@index([organizationId])
  @@index([studentId])
  @@schema("edupilot")
}

/// 教师对一节课的原始记录。一节课只保留一份，内部备注不会进入家长可见的报告。
model TeachingRecord {
  id                  String        @id @default(cuid())
  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id])
  lessonSessionId     String        @unique
  lessonSession       LessonSession @relation(fields: [lessonSessionId], references: [id])
  teacherId           String
  teacher             Teacher       @relation(fields: [teacherId], references: [id])
  lessonContent       String        @default("")
  studentPerformance  String        @default("")
  difficulties        String        @default("")
  homework            String?
  teacherPrivateNote  String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  reports             TeachingReport[]

  @@index([organizationId])
  @@index([teacherId])
  @@schema("edupilot")
}

/// 面向单个学生的教学报告。发布前家长不可见。
model TeachingReport {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id])
  lessonSessionId  String
  lessonSession    LessonSession @relation(fields: [lessonSessionId], references: [id])
  studentId        String
  student          Student       @relation(fields: [studentId], references: [id])
  teachingRecordId String
  teachingRecord   TeachingRecord @relation(fields: [teachingRecordId], references: [id])
  status           ReportStatus  @default(DRAFT)
  summary          String        @default("")
  strengths        String        @default("")
  issues           String        @default("")
  nextSteps        String        @default("")
  homeworkSummary  String?
  aiModel          String?
  promptVersion    String?
  generatedAt      DateTime?
  confirmedById    String?
  confirmedBy      User?         @relation("ReportConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt      DateTime?
  publishedById    String?
  publishedBy      User?         @relation("ReportPublishedBy", fields: [publishedById], references: [id])
  publishedAt      DateTime?
  revisionNote     String?
  revision         Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@unique([lessonSessionId, studentId])
  @@index([organizationId, status])
  @@index([studentId])
  @@schema("edupilot")
}

/// 关键操作的轻量记录。只保存操作人、时间和动作，不保存密码或密钥。
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorId        String
  actor          User         @relation(fields: [actorId], references: [id])
  action         String
  targetType     String
  targetId       String
  detail         String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@schema("edupilot")
}

/// 手机验证码或注册票据。只保存哈希，用过后立即失效。
model PhoneVerification {
  id          String    @id @default(cuid())
  phone       String
  purpose     String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone, createdAt])
  @@schema("edupilot")
}

/// 负责人签发的一次性加入凭证。角色和机构以这条记录为准，不接受调用方指定。
model MembershipInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  kind           String
  codeHash       String       @unique
  studentId      String?
  student        Student?     @relation(fields: [studentId], references: [id])
  teacherId      String?
  teacher        Teacher?     @relation(fields: [teacherId], references: [id])
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@schema("edupilot")
}

/// 已验证但尚未分配机构角色的手机号。不创建工作台权限。
model PhoneSignup {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String
  createdAt DateTime @default(now())

  @@schema("edupilot")
}
