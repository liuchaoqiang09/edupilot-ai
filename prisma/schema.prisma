generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["edupilot"]
}

enum Role {
  OWNER
  TEACHER
  PARENT

  @@schema("edupilot")
}

enum MemberStatus {
  ACTIVE
  INACTIVE

  @@schema("edupilot")
}

enum CourseCategory {
  ACADEMIC
  ART
  EARLY_CHILDHOOD
  OTHER

  @@schema("edupilot")
}

enum ArchiveStatus {
  ACTIVE
  ARCHIVED

  @@schema("edupilot")
}

enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED

  @@schema("edupilot")
}

enum AttendanceStatus {
  NOT_MARKED
  PRESENT
  ABSENT
  LATE
  LEAVE

  @@schema("edupilot")
}

/// 请假细分。仅当 attendanceStatus=LEAVE 时有意义；家长请假默认 PERSONAL。
enum LeaveKind {
  PERSONAL
  SICK

  @@schema("edupilot")
}

enum LessonSeat {
  ENROLLED
  GUEST
  TRIAL
  CONVERTED

  @@schema("edupilot")
}

enum RenewalOutcome {
  TO_CONTACT
  CONTACTED
  NEXT_BOOKED
  DECLINED
  RENEWED

  @@schema("edupilot")
}

enum ReportStatus {
  DRAFT
  CONFIRMED
  PUBLISHED
  RETURNED

  @@schema("edupilot")
}

enum EnrollmentStatus {
  PAID
  PARTIAL
  UNPAID

  @@schema("edupilot")
}

enum BillingType {
  PER_LESSON
  PER_PERIOD

  @@schema("edupilot")
}

enum PaymentMethod {
  CASH
  WECHAT
  ALIPAY
  BANK
  OTHER

  @@schema("edupilot")
}

/// 机构是租户边界。主键即租户标识，业务数据通过 organizationId 指向这里。
model Organization {
  id                     String           @id @default(cuid())
  name                   String
  timezone               String           @default("Asia/Shanghai")
  businessTypes          CourseCategory[] @default([ACADEMIC])
  reportLanguage         String           @default("zh-CN")
  aiUseRecentSummaries   Boolean          @default(true)
  aiRequireEvidence      Boolean          @default(true)
  aiTeacherMustConfirm   Boolean          @default(true)
  aiOwnerSpotCheck       Boolean          @default(true)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  users              User[]
  students           Student[]
  teachers           Teacher[]
  courses            Course[]
  classGroups        ClassGroup[]
  parentStudentLinks ParentStudentLink[]
  lessonSessions     LessonSession[]
  lessonStudents     LessonStudent[]
  teachingRecords    TeachingRecord[]
  teachingReports    TeachingReport[]
  enrollments        Enrollment[]
  auditLogs          AuditLog[]
  courseHourBalances CourseHourBalance[]
  hourAdjustments    HourAdjustment[]
  payments           Payment[]
  renewalFollowUps   RenewalFollowUp[]
  membershipInvites  MembershipInvite[]
  classrooms         Classroom[]
  classWaitlists     ClassWaitlist[]
  reportReads        ReportRead[]
  reportPhotos       ReportPhoto[]
  lessonChangeRequests LessonChangeRequest[]
  reportReplies      ReportReply[]
  parentNotices      ParentNotice[]
  homeworkSubmissions HomeworkSubmission[]
  homeworkAssets     HomeworkAsset[]
  exams              Exam[]
  examResults        ExamResult[]
  examReads          ExamRead[]

  @@schema("edupilot")
}

/// 登录身份。邮箱仍可用于密码登录；手机号可空，同一个手机号只能对应一个账号。
model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  email          String       @unique
  phone          String?      @unique
  passwordHash   String
  name           String
  roles          Role[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  teacherProfile     Teacher?             @relation("TeacherLogin")
  accountTeacher     Teacher?             @relation("TeacherAccount")
  parentStudentLinks ParentStudentLink[]
  createdLessons     LessonSession[]
  confirmedReports   TeachingReport[] @relation("ReportConfirmedBy")
  publishedReports   TeachingReport[] @relation("ReportPublishedBy")
  createdEnrollments Enrollment[]
  auditLogs          AuditLog[]
  hourAdjustments    HourAdjustment[]
  payments           Payment[]
  renewalFollowUps   RenewalFollowUp[]
  membershipInvites  MembershipInvite[]
  reportReads        ReportRead[]
  lessonRequests     LessonChangeRequest[] @relation("LessonRequestBy")
  reviewedLessonRequests LessonChangeRequest[] @relation("LessonRequestReview")
  reportReplies      ReportReply[]
  parentNotices      ParentNotice[]
  homeworkSubmitted  HomeworkSubmission[] @relation("HomeworkSubmittedBy")
  examsPublished     Exam[] @relation("ExamPublishedBy")
  examReads          ExamRead[]

  @@index([organizationId])
  @@schema("edupilot")
}

/// 学生档案。停用只改变状态，不删除记录。
model Student {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  studentNo      String?
  grade          String?
  /// 年龄，只存整数。空表示未填写。
  age            Int?
  /// 家长姓名。空表示报名和学生档案都还没填写。
  guardianName   String?
  /// 报名时填写的联系人电话。空表示还没有从报名同步过来。
  guardianPhone  String?
  contactNote    String?
  status         MemberStatus       @default(ACTIVE)
  /// 停用时填写的原因。恢复在读后清空。
  archiveReason  String?
  /// 旧的学员总课时。新的扣课以 CourseHourBalance 为准，不再读写这个字段。
  remainingHours Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  parentLinks    ParentStudentLink[]
  lessonStudents LessonStudent[]
  teachingReports TeachingReport[]
  enrollments    Enrollment[]
  courseHourBalances CourseHourBalance[]
  hourAdjustments HourAdjustment[]
  renewalFollowUps RenewalFollowUp[]
  membershipInvites MembershipInvite[]
  classWaitlists ClassWaitlist[]
  homeworkSubmissions HomeworkSubmission[]
  examResults        ExamResult[]
  examReads          ExamRead[]

  @@unique([organizationId, studentNo])
  @@index([organizationId])
  @@schema("edupilot")
}

/// 教师档案。可以先独立存在，之后再关联登录账号。
model Teacher {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?      @unique
  user           User?        @relation("TeacherLogin", fields: [userId], references: [id], onDelete: SetNull)
  /// 这位老师注册过的登录账号。取消关联时保留，方便以后重新关联，不包含密码。
  accountUserId  String?      @unique
  accountUser    User?        @relation("TeacherAccount", fields: [accountUserId], references: [id], onDelete: SetNull)
  name           String
  /// 机构内的教师编号。空表示还没填写，新增时不强制。
  teacherNo      String?
  /// 11 位手机号。空表示未填写。
  phone          String?
  /// 微信号，只含字母、数字和下划线。
  wechat         String?
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  classGroups    ClassGroup[]
  lessonSessions LessonSession[]
  teachingRecords TeachingRecord[]
  membershipInvites MembershipInvite[]
  courses        TeacherCourse[]
  substituteRequests LessonChangeRequest[] @relation("SubstituteTeacher")
  homeworkGraded     HomeworkSubmission[] @relation("HomeworkGradedBy")
  exams              Exam[]

  @@unique([organizationId, teacherNo])
  @@index([organizationId])
  @@schema("edupilot")
}

/// 课程类型。名称由机构自建，不等于某一节课。
model Course {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  category       CourseCategory?
  description    String?
  billingType    BillingType     @default(PER_LESSON)
  status         ArchiveStatus   @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  classGroups    ClassGroup[]
  teachers       TeacherCourse[]
  enrollments    Enrollment[]
  lessonSessions LessonSession[]
  courseHourBalances CourseHourBalance[]
  hourAdjustments HourAdjustment[]
  renewalFollowUps RenewalFollowUp[]
  exams          Exam[]

  @@index([organizationId])
  @@schema("edupilot")
}

/// 教师可教授的课程。同一对教师和课程只保留一条。
model TeacherCourse {
  teacherId String
  courseId  String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([teacherId, courseId])
  @@index([courseId])
  @@schema("edupilot")
}

/// 班级或教学组。主讲教师可在以后的课次里单独调整。
model ClassGroup {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  name           String
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id])
  teacherId      String
  teacher        Teacher       @relation(fields: [teacherId], references: [id])
  capacity       Int?
  status         ArchiveStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lessonSessions LessonSession[]
  enrollments    Enrollment[]
  waitlist       ClassWaitlist[]
  exams          Exam[]

  @@index([organizationId])
  @@index([courseId])
  @@index([teacherId])
  @@schema("edupilot")
}

/// 某一天实际发生的一节课。课程和教师在创建时单独保存，之后改班级不会改写历史课次。
model LessonSession {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  classGroupId   String
  classGroup     ClassGroup    @relation(fields: [classGroupId], references: [id])
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id])
  teacherId      String
  teacher        Teacher       @relation(fields: [teacherId], references: [id])
  title          String?
  startAt        DateTime
  endAt          DateTime
  location       String?
  /// 从教室表选择的教室。旧课次只有地点文字，这个字段留空。
  classroomId    String?
  classroom      Classroom?    @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  status         LessonStatus  @default(SCHEDULED)
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  students       LessonStudent[]
  teachingRecord TeachingRecord?
  changeRequests LessonChangeRequest[]
  reports        TeachingReport[]
  homeworkSubmissions HomeworkSubmission[]

  @@index([organizationId, startAt])
  @@index([teacherId, startAt])
  @@index([classGroupId])
  @@index([classroomId])
  @@schema("edupilot")
}

/// 机构教室。新排课从这里选择；停用后不再出现在下拉框，已排课次仍保留。
model Classroom {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  name           String
  capacity       Int
  available      Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lessons        LessonSession[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@schema("edupilot")
}

/// 班级排队。排队学生还不是这个班的在读学员，也不会进入课表。
model ClassWaitlist {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  classGroupId   String
  classGroup     ClassGroup   @relation(fields: [classGroupId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([studentId, classGroupId])
  @@index([organizationId, classGroupId])
  @@schema("edupilot")
}

/// 一节课的实际学生名单和考勤。同一课次里同一学生只能出现一次。
model LessonStudent {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id])
  lessonSessionId  String
  lessonSession    LessonSession    @relation(fields: [lessonSessionId], references: [id])
  studentId        String
  student          Student          @relation(fields: [studentId], references: [id])
  attendanceStatus AttendanceStatus @default(NOT_MARKED)
  attendanceNote   String?
  /// 事假 / 病假。仅请假时填写；非请假为 null。旧请假数据迁移为 PERSONAL。
  leaveKind        LeaveKind?
  /// 家长在开课前请假的时间。老师把考勤改成其他状态后会清掉。
  parentLeaveAt    DateTime?
  parentLeaveNote  String?
  hoursCharged     Boolean          @default(false)
  seat             LessonSeat       @default(ENROLLED)
  makeupSourceId   String?          @unique
  makeupSource     LessonStudent?   @relation("LessonMakeup", fields: [makeupSourceId], references: [id], onDelete: SetNull)
  makeups          LessonStudent[]  @relation("LessonMakeup")
  lastAction       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([lessonSessionId, studentId])
  @@index([organizationId])
  @@index([studentId])
  @@schema("edupilot")
}

/// 某一学员在某一课程上的可用课时。同一学员的不同课程分开记账。
model CourseHourBalance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id])
  remainingHours Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([studentId, courseId])
  @@index([organizationId])
  @@schema("edupilot")
}

/// 一次报名或缴费。购买课时加到对应课程的可用课时，不并入其他课程。
model Enrollment {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id])
  courseId       String
  course         Course           @relation(fields: [courseId], references: [id])
  /// 报名所在班级。旧数据可先留空，排课按这个字段取本班学生。
  classGroupId   String?
  classGroup     ClassGroup?      @relation(fields: [classGroupId], references: [id], onDelete: SetNull)
  amountDue      Decimal          @db.Decimal(10, 2)
  amount         Decimal          @db.Decimal(10, 2)
  /// 折扣率百分数，80 表示按应收的 80% 计算实际收费。空表示没有填写折扣。
  discountPercent Decimal?        @db.Decimal(5, 2)
  hoursAdded     Int
  status         EnrollmentStatus
  /// 按周期报名的有效期。按课时报名时留空。
  startDate      DateTime?        @db.Date
  endDate        DateTime?        @db.Date
  paidAt         DateTime?
  createdById    String
  createdBy      User             @relation(fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  payments       Payment[]

  @@index([organizationId, createdAt])
  @@index([studentId])
  @@index([courseId])
  @@index([classGroupId])
  @@schema("edupilot")
}

/// 家长与学生的绑定。同一对关系只能存在一次。
model ParentStudentLink {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  parentUserId   String
  parent         User         @relation(fields: [parentUserId], references: [id])
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([parentUserId, studentId])
  @@index([organizationId])
  @@index([studentId])
  @@schema("edupilot")
}

/// 教师对一节课的原始记录。一节课只保留一份，内部备注不会进入家长可见的报告。
model TeachingRecord {
  id                  String        @id @default(cuid())
  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id])
  lessonSessionId     String        @unique
  lessonSession       LessonSession @relation(fields: [lessonSessionId], references: [id])
  teacherId           String
  teacher             Teacher       @relation(fields: [teacherId], references: [id])
  lessonContent       String        @default("")
  studentPerformance  String        @default("")
  difficulties        String        @default("")
  homework            String?
  /// 作业截止时间（上海日历语义由业务层解释）。空表示不设截止。
  homeworkDueAt       DateTime?
  teacherPrivateNote  String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  reports             TeachingReport[]

  @@index([organizationId])
  @@index([teacherId])
  @@schema("edupilot")
}

enum HomeworkStatus {
  SUBMITTED
  RETURNED
  GRADED
  COMPLETED

  @@schema("edupilot")
}

enum HomeworkAssetKind {
  IMAGE
  FILE

  @@schema("edupilot")
}

/// 一名学生对一节课作业的提交。布置内容仍在 TeachingRecord.homework。
model HomeworkSubmission {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id])
  lessonSessionId   String
  lessonSession     LessonSession  @relation(fields: [lessonSessionId], references: [id])
  studentId         String
  student           Student        @relation(fields: [studentId], references: [id])
  body              String         @default("")
  status            HomeworkStatus @default(SUBMITTED)
  submittedAt       DateTime?
  submittedById     String?
  submittedBy       User?          @relation("HomeworkSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  feedback          String?
  score             String?
  gradedAt          DateTime?
  gradedByTeacherId String?
  gradedByTeacher   Teacher?       @relation("HomeworkGradedBy", fields: [gradedByTeacherId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  assets            HomeworkAsset[]

  @@unique([lessonSessionId, studentId])
  @@index([organizationId, status])
  @@index([studentId])
  @@index([gradedByTeacherId])
  @@schema("edupilot")
}

/// 作业提交的照片或附件，文件落在 uploads/homework-assets。
model HomeworkAsset {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id])
  submissionId   String
  submission     HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  kind           HomeworkAssetKind
  fileName       String
  contentType    String
  sizeBytes      Int
  createdAt      DateTime          @default(now())

  @@index([organizationId])
  @@index([submissionId])
  @@schema("edupilot")
}

/// 面向单个学生的教学报告。发布前家长不可见。
model TeachingReport {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id])
  lessonSessionId  String
  lessonSession    LessonSession @relation(fields: [lessonSessionId], references: [id])
  studentId        String
  student          Student       @relation(fields: [studentId], references: [id])
  teachingRecordId String
  teachingRecord   TeachingRecord @relation(fields: [teachingRecordId], references: [id])
  status           ReportStatus  @default(DRAFT)
  summary          String        @default("")
  strengths        String        @default("")
  issues           String        @default("")
  nextSteps        String        @default("")
  homeworkSummary  String?
  aiModel          String?
  promptVersion    String?
  generatedAt      DateTime?
  confirmedById    String?
  confirmedBy      User?         @relation("ReportConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt      DateTime?
  publishedById    String?
  publishedBy      User?         @relation("ReportPublishedBy", fields: [publishedById], references: [id])
  publishedAt      DateTime?
  revisionNote     String?
  revision         Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  reads            ReportRead[]
  photos           ReportPhoto[]
  replies          ReportReply[]

  @@unique([lessonSessionId, studentId])
  @@index([organizationId, status])
  @@index([studentId])
  @@schema("edupilot")
}

enum LessonRequestKind {
  RESCHEDULE
  SUBSTITUTE

  @@schema("edupilot")
}

enum LessonRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@schema("edupilot")
}

/// 教师提出的调课或代课。负责人同意前，课次时间和对授课教师都不变。
model LessonChangeRequest {
  id                  String              @id @default(cuid())
  organizationId      String
  organization        Organization        @relation(fields: [organizationId], references: [id])
  lessonSessionId     String
  lessonSession       LessonSession       @relation(fields: [lessonSessionId], references: [id])
  kind                LessonRequestKind
  status              LessonRequestStatus @default(PENDING)
  startAt             DateTime?
  endAt               DateTime?
  substituteTeacherId String?
  substituteTeacher   Teacher?            @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id])
  note                String              @default("")
  requestedById       String
  requestedBy         User                @relation("LessonRequestBy", fields: [requestedById], references: [id])
  reviewedById        String?
  reviewedBy          User?               @relation("LessonRequestReview", fields: [reviewedById], references: [id])
  reviewNote          String?
  createdAt           DateTime            @default(now())
  reviewedAt          DateTime?

  @@index([organizationId, status])
  @@index([lessonSessionId])
  @@schema("edupilot")
}

/// 家长对一份已发布报告的回复。一份报告每位家长只保留一条，可以改。
model ReportReply {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  reportId       String
  report         TeachingReport @relation(fields: [reportId], references: [id])
  parentUserId   String
  parent         User           @relation(fields: [parentUserId], references: [id])
  body           String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([reportId, parentUserId])
  @@index([organizationId])
  @@schema("edupilot")
}

enum ParentNoticeKind {
  LESSON
  HOMEWORK
  REPORT
  MAKEUP
  EXAM

  @@schema("edupilot")
}

enum ExamStatus {
  DRAFT
  PUBLISHED

  @@schema("edupilot")
}

enum ExamScoreMode {
  POINTS
  GRADE
  PASS_FAIL

  @@schema("edupilot")
}

/// 一次考试/测评。挂在班级上，与单节课教学报告、作业提交分开。
model Exam {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  classGroupId   String
  classGroup     ClassGroup    @relation(fields: [classGroupId], references: [id])
  courseId       String
  course         Course        @relation(fields: [courseId], references: [id])
  teacherId      String
  teacher        Teacher       @relation(fields: [teacherId], references: [id])
  title          String
  examDate       DateTime
  scoreMode      ExamScoreMode @default(POINTS)
  maxScore       Decimal?      @db.Decimal(6, 1)
  classSummary   String?
  showAverage    Boolean       @default(false)
  status         ExamStatus    @default(DRAFT)
  publishedAt    DateTime?
  publishedById  String?
  publishedBy    User?         @relation("ExamPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  revision       Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  results        ExamResult[]
  reads          ExamRead[]

  @@index([organizationId, status])
  @@index([teacherId, examDate])
  @@index([classGroupId])
  @@schema("edupilot")
}

/// 一名学生在一次考试中的成绩与个人评语。
model ExamResult {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  examId         String
  exam           Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  /// 分数模式使用；缺考或未录入时为空。
  score          Decimal?     @db.Decimal(6, 1)
  /// 等级或合格/不合格文案。
  gradeLabel     String?
  absent         Boolean      @default(false)
  /// 是否已由教师录入（含缺考）。未录入的结果发布后不对家长展示。
  entered        Boolean      @default(false)
  comment        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([examId, studentId])
  @@index([organizationId])
  @@index([studentId])
  @@schema("edupilot")
}

/// 家长第一次打开某次已发布考试中自己孩子的成绩。
model ExamRead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  examId         String
  exam           Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  parentUserId   String
  parent         User         @relation(fields: [parentUserId], references: [id])
  openedAt       DateTime     @default(now())

  @@unique([examId, studentId, parentUserId])
  @@index([organizationId])
  @@schema("edupilot")
}

/// 发给已绑定家长的站内提醒。同一家长、同一事件只保留一条。
model ParentNotice {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  parentUserId   String
  parent         User             @relation(fields: [parentUserId], references: [id])
  kind           ParentNoticeKind
  title          String
  body           String
  href           String
  dedupeKey      String
  /// 业务相关时间（考试日、上课时间等），列表按此排序；createdAt 仍是送达时间。
  occurredAt     DateTime         @default(now())
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@unique([parentUserId, dedupeKey])
  @@index([organizationId, parentUserId, readAt])
  @@index([organizationId, parentUserId, occurredAt])
  @@schema("edupilot")
}

/// 报告上的课堂照片。发布前只有本机构教师和负责人能看，发布后绑定的家长也能看。
model ReportPhoto {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  reportId       String
  report         TeachingReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  contentType    String
  createdAt      DateTime       @default(now())

  @@index([organizationId])
  @@index([reportId])
  @@schema("edupilot")
}

/// 家长第一次打开已发布报告的时间。同一家长对同一报告只记一次。
model ReportRead {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  reportId       String
  report         TeachingReport @relation(fields: [reportId], references: [id])
  parentUserId   String
  parent         User           @relation(fields: [parentUserId], references: [id])
  openedAt       DateTime       @default(now())

  @@unique([reportId, parentUserId])
  @@index([organizationId])
  @@schema("edupilot")
}

/// 一次课时增减。余额在同一事务里更新，减完不能小于 0。按周期课程不写这张表。
model HourAdjustment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  studentId      String
  student        Student      @relation(fields: [studentId], references: [id])
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id])
  deltaHours     Int
  reason         String
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([studentId])
  @@schema("edupilot")
}

/// 一笔收款或退费。退费金额为负数。作废后保留记录，不计入实收。
model Payment {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  enrollmentId   String
  enrollment     Enrollment    @relation(fields: [enrollmentId], references: [id])
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  paidAt         DateTime
  reason         String?
  voidedAt       DateTime?
  voidReason     String?
  createdById    String
  createdBy      User          @relation(fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())

  @@index([organizationId, paidAt])
  @@index([enrollmentId])
  @@schema("edupilot")
}

/// 待续费跟进。新的报名会再写一条「已续费」，不覆盖以前的记录。
model RenewalFollowUp {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  studentId      String
  student        Student         @relation(fields: [studentId], references: [id])
  courseId       String
  course         Course          @relation(fields: [courseId], references: [id])
  outcome        RenewalOutcome
  note           String?
  nextContactOn  DateTime?       @db.Date
  createdById    String
  createdBy      User            @relation(fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())

  @@index([organizationId, studentId, courseId, createdAt])
  @@schema("edupilot")
}

/// 关键操作的轻量记录。只保存操作人、时间和动作，不保存密码或密钥。
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  actorId        String
  actor          User         @relation(fields: [actorId], references: [id])
  action         String
  targetType     String
  targetId       String
  detail         String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@schema("edupilot")
}

/// 手机验证码或注册票据。只保存哈希，用过后立即失效。
model PhoneVerification {
  id          String    @id @default(cuid())
  phone       String
  purpose     String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone, createdAt])
  @@schema("edupilot")
}

/// 负责人签发的一次性加入凭证。角色和机构以这条记录为准，不接受调用方指定。
model MembershipInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  kind           String
  codeHash       String       @unique
  studentId      String?
  student        Student?     @relation(fields: [studentId], references: [id])
  teacherId      String?
  teacher        Teacher?     @relation(fields: [teacherId], references: [id])
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@schema("edupilot")
}

/// 已验证但尚未分配机构角色的手机号。不创建工作台权限。
model PhoneSignup {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String
  createdAt DateTime @default(now())

  @@schema("edupilot")
}
